<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[PeoplePortal.Domain*]*,[PeoplePortal.Application*]*</Include>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <Exclude>[xunit.*]*,[FluentAssertions.*]*,[NSubstitute.*]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
